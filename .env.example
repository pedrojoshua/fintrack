# ── Obrigatório ──────────────────────────────────────
# Postgres (no Coolify usa a Internal URL do serviço)
DATABASE_URL=postgres://utilizador:senha@host:5432/fintrack
# Chave para assinar os tokens de sessão. Mínimo 16 caracteres.
# Gera com: openssl rand -hex 32
SESSION_SECRET=

# ── Recomendado ──────────────────────────────────────
# URL pública da app. Sem isto os webhooks não são configurados
# e o Telegram cai para polling.
APP_URL=https://fintrack.exemplo.com
# Segredo que protege os endpoints de webhook.
WEBHOOK_TOKEN=

# ── WhatsApp (Evolution API) ─────────────────────────
# Sem estas variáveis o canal WhatsApp fica desativado.
EVOLUTION_URL=http://evolution-xxxxx:8080
EVOLUTION_KEY=
EVOLUTION_INSTANCE=fintrack

# ── Telegram (opcional) ──────────────────────────────
TELEGRAM_TOKEN=

# ── Servidor ─────────────────────────────────────────
PORT=3000
